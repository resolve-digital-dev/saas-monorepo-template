{
  "name": "@resolvedigital/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./messages": {
      "types": "./types/paraglide/messages.d.ts",
      "default": "./src/paraglide/messages.js"
    },
    "./runtime": {
      "types": "./types/paraglide/runtime.d.ts",
      "default": "./src/paraglide/runtime.js"
    }
  },
  "scripts": {
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsc -p tsconfig.build.json",
    "clean": "rimraf --glob src/paraglide types .turbo *.tsbuildinfo",
    "lint": "eslint . --max-warnings 0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.24.1"
  },
  "devDependencies": {
    "@inlang/plugin-message-format": "^4.4.3",
    "@resolvedigital/eslint-config": "workspace:*",
    "@resolvedigital/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
