{
  "name": "@resolvedigital/logger",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "rimraf --glob dist .turbo coverage *.tsbuildinfo",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@resolvedigital/eslint-config": "workspace:*",
    "@resolvedigital/typescript-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
