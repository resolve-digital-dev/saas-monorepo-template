# dependencies
node_modules/

# build outputs
dist/
.next/
build/
out/
.turbo/
coverage/
*.tsbuildinfo

# generated code (paraglide compiles these from packages/i18n/messages)
packages/i18n/src/paraglide/
packages/i18n/types/

# environment variables — the template ships .env.example only
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# editor: shared workspace settings ARE committed, personal state is not
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# system
.DS_Store
Thumbs.db
