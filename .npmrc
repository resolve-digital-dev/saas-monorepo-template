# Fail loudly on unmet peer dependencies instead of auto-inventing a resolution.
strict-peer-dependencies=true
auto-install-peers=false

# No public hoisting: every package must declare what it imports. Hoisting is
# what previously made missing eslint plugins "work" by accident.
shamefully-hoist=false
resolution-mode=highest

# `engines` in package.json is a contract, not a suggestion. Without this the
# field is advisory and a Node 20 developer silently gets a broken install.
engine-strict=true
