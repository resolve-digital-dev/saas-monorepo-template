{
  "name": "resolvedigital-template",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rimraf --glob node_modules/.cache .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,md,css,yml,yaml}\"",
    "db:push": "pnpm --filter @resolvedigital/database db:push",
    "db:generate": "pnpm --filter @resolvedigital/database db:generate",
    "db:migrate": "pnpm --filter @resolvedigital/database db:migrate",
    "db:seed": "pnpm --filter @resolvedigital/database db:seed",
    "db:studio": "pnpm --filter @resolvedigital/database db:studio",
    "rename": "node scripts/rename.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.24.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}": [
      "eslint --flag v10_config_lookup_from_file --no-warn-ignored --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
