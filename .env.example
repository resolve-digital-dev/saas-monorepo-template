# -----------------------------------------------------------------------------
# Single source of truth for every app in the monorepo.
# Copy to .env at the repository root: cp .env.example .env
# -----------------------------------------------------------------------------

# --- PostgreSQL (consumed by docker-compose) ---------------------------------
POSTGRES_USER=postgres
# Change this before exposing the database anywhere but localhost.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resolvedigital

# --- Database ----------------------------------------------------------------
# Used by the backend, drizzle-kit and the seed/migrate scripts.
# There is no fallback: a missing or malformed value fails fast, and the scheme
# must be postgres:// or postgresql:// (a bare "localhost:5432" is a valid URL
# as far as the URL parser is concerned, so it is rejected explicitly).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolvedigital
# Validated as a positive integer - "abc" is rejected rather than handed to the
# driver as NaN.
DATABASE_POOL_MAX=10
# Only 1/true/yes enable it. 0 and false do not.
DATABASE_SSL=false

# --- Backend (NestJS) --------------------------------------------------------
PORT=3001
# fatal | error | warn | info | debug | trace | silent. Owned and validated by
# packages/logger. Defaults to debug outside production, info in production.
LOG_LEVEL=debug
# Comma-separated CORS allowlist. Empty means "no browser origin allowed".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Rate limiting, per client: RATE_LIMIT_LIMIT requests per RATE_LIMIT_TTL
# seconds. /api/health is exempt so probes cannot be throttled into a restart.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
# OpenAPI UI at /api/docs. Defaults to on everywhere except production.
# SWAGGER_ENABLED=

# --- Frontends ---------------------------------------------------------------
# Routes are versioned: the backend serves /api/v1/* (health stays at
# /api/health). These URLs point at the /api prefix, not at /api/v1.
#
# NEXT_PUBLIC_* and VITE_* are inlined at BUILD time and must be reachable from
# the *browser*.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api
# Read at RUNTIME by the landing's server components. Inside docker-compose this
# has to be the service name, because localhost means the landing container
# itself. Falls back to NEXT_PUBLIC_API_URL when unset.
# API_URL=http://backend:3001/api

# Bypasses env validation for builds and lint jobs that boot nothing.
# Only 1, true or yes switch it on - 0 and false leave validation enabled.
# SKIP_ENV_VALIDATION=
